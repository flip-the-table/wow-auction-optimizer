# Blizzard OAuth credentials
BLIZZARD_CLIENT_ID=your_client_id_here
BLIZZARD_CLIENT_SECRET=your_client_secret_here

# Region + locale
REGION=us
LOCALE=en_US
NAMESPACE_DYNAMIC=dynamic-us
NAMESPACE_STATIC=static-us

# Ingest cadence + scoring
INGEST_INTERVAL_MINUTES=60
WEIGHT_DEMAND=0.65
WEIGHT_PRICE=0.35

# Liquidity guards
MIN_LISTING_COUNT=20
MIN_TOTAL_QUANTITY=50
MIN_SNAPSHOTS_FOR_CONFIDENCE=6

# EWMA smoothing
EWMA_ALPHA=0.3

# Baseline window (days)
BASELINE_WINDOW_DAYS=14

# Database
DATABASE_URL=postgresql+asyncpg://wow:wow@localhost:5432/wow_auction
DATABASE_URL_SYNC=postgresql://wow:wow@localhost:5432/wow_auction

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_PORT=8000
API_HOST=0.0.0.0

# Cloud deployment
CLOUD_PROVIDER=gcp
ENVIRONMENT=dev
GCP_PROJECT_ID=your-gcp-project
GCP_REGION=us-central1
