# Blizzard OAuth credentials
BLIZZARD_CLIENT_ID=your_client_id_here
BLIZZARD_CLIENT_SECRET=your_client_secret_here

# Region + locale
REGION=us
LOCALE=en_US
NAMESPACE_DYNAMIC=dynamic-us
NAMESPACE_STATIC=static-us

# Ingest cadence + scoring
INGEST_INTERVAL_MINUTES=60
WEIGHT_DEMAND=0.65
WEIGHT_PRICE=0.35

# Liquidity guards
MIN_LISTING_COUNT=20
MIN_TOTAL_QUANTITY=50
MIN_SNAPSHOTS_FOR_CONFIDENCE=6

# EWMA smoothing
EWMA_ALPHA=0.3

# Baseline window (days)
BASELINE_WINDOW_DAYS=14

# Database (AWS RDS)
DATABASE_URL=postgresql+asyncpg://user:password@your-rds-host.rds.amazonaws.com:5432/wow_auction
DATABASE_URL_SYNC=postgresql://user:password@your-rds-host.rds.amazonaws.com:5432/wow_auction

# Redis (Upstash) - enables API response caching (5-min TTL)
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
REDIS_URL=rediss://default:your_token@your-endpoint.upstash.io:6379

# API
API_PORT=8000
API_HOST=0.0.0.0
